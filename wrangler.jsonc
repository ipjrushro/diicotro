{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diicotro",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "define": {
    "process.versions.node": "undefined"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PORT": "3000",
    "NODE_ENV": "production"
  }
}
